# Block commits that contain secrets (API keys, passwords, connection strings).
# Needs gitleaks: brew install gitleaks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); commit blocked." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --verbose
